-- Solution --

-- Find top 5 products by sale
WITH cte AS
(SELECT product, sum(sales) AS sales FROM orders
GROUP BY product)
SELECT * FROM cte ORDER By sales DESC LIMIT 5;

-- Find top 2 products who made most sales in each category
WITH cte AS
(
	SELECT category, product, SUM(sales) AS sales
	FROM orders
    GROUP BY category, product
),
cte1 AS
(SELECT *, RANK() OVER (PARTITION BY category ORDER BY sales DESC) AS rn FROM cte)
SELECT * FROM cte1 WHERE rn <= 2;
