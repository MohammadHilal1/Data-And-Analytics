-- Write a sql query to find users who purchased different products on different dates


-- SQL query to create table and insert data
create table purchase_history
(userid int
,productid int
,purchasedate date
);
insert into purchase_history values
(1, 1, '2012-01-23'),
(1, 2, '2012-01-23'),
(1, 3, '2012-01-25'),
(2, 1, '2012-01-23'),
(2, 2, '2012-01-23'),
(2, 2, '2012-01-25'),
(2, 4, '2012-01-25'),
(3, 4, '2012-01-23'),
(3, 1, '2012-01-23'),
(4, 1, '2012-01-23'),
(4, 2, '2012-01-25');

-- Solution --

WITH cte AS
(SELECT userid,
COUNT(distinct purchasedate) AS days_purchased,
COUNT(productid) AS products_buyed,
COUNT(DISTINCT productid) AS  dist_products_buyed FROM purchase_history
GROUP BY userid)
SELECT userid FROM cte WHERE days_purchased > 1 AND products_buyed = dist_products_buyed;
