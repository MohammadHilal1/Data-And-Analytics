-- Given employee and salary_history You are asked to answer the following questions
-- Find the latest salary for each employee
-- Total number of promotions received by each employee
-- Identify employees whose salary has never decreased over time
-- Find the average time between salary changes for each employees
-- Rank employees by salary growth rate, breaking ties by earliest join date

-- SQL query to create table and insert data
CREATE TABLE employees (
    employee_id INT PRIMARY KEY,
    name VARCHAR(10) NOT NULL,
    join_date DATE NOT NULL,
    department VARCHAR(10) NOT NULL
);

