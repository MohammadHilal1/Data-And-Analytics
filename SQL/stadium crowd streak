--You are given a stadium table that logs the number of people visiting the stadium each day, along with a unique ID and visit_date for each record. 
--The stadium management wants to identify streaks of at least three consecutive days where more than 100 people attended.
--Write a query to:
--Filter out days where attendance was 100 or fewer.
--Identify consecutive days (based on visit_date order) where attendance was above 100.
--Return the records (id, visit_date, no_of_people) for all such streaks only if the streak lasted for 3 or more consecutive days.

--Sql Query to create table and insert data
create table stadium (
id int,
visit_date date,
no_of_people int
);

insert into stadium
values (1,'2017-07-01',10)
,(2,'2017-07-02',109)
,(3,'2017-07-03',150)
,(4,'2017-07-04',99)
,(5,'2017-07-05',145)
,(6,'2017-07-06',1455)
,(7,'2017-07-07',199)
,(8,'2017-07-08',188);

--Solution
WITH cte AS
(SELECT *, ROW_NUMBER() OVER (ORDER BY visit_date) AS rn,
id - row_number() OVER (ORDER BY visit_date) AS group_key
FROM stadium
where no_of_people > 100),
cte1 AS
(SELECT *, count(1) OVER (PArtition BY group_key) AS cons_count 
FROM cte)
SELECT id, visit_date, no_of_people FROM cte1 WHERE cons_count >= 3;
