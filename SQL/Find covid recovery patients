-- Solution

WITH cte AS (SELECT * , 
ROW_NUMBER() OVER (PARTITION BY patient_id, result ORDER BY test_date) AS rnk1
FROM covid_tests),
cte1 AS
(SELECT c1.patient_id, 
ROW_NUMBER() OVER (PARTITION BY c1.patient_id ORDER BY c2.test_date) AS rnk2,
DATEDIFF(c2.test_date, c1.test_date) AS recovery_time
FROM cte AS c1
LEFT JOIN cte AS c2
ON c1.patient_id = c2.patient_id
AND c1.test_date < c2.test_date
WHERE c1.result = "Positive"
AND c1.rnk1 = 1 AND c2.result = "Negative")
SELECT p.patient_id, p.patient_name, 
p.age, cte1.recovery_time  FROM cte1
INNER JOIN
patients p
ON cte1.patient_id = p.patient_id AND cte1.rnk2 = 1
ORDER BY cte1.recovery_time ASC, p.patient_name ASC;
