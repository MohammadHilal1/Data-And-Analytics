-- Given a subscription history table containing customer_id, marketplace, event_date, event and subscription period in months
-- Event can be subscribe, Renewal, Cancellation
-- Assume that only one customer can be in one market place
-- Find the number of active prime members at the end of 2020 in each marketplace

-- Sql query to create table and insert data

CREATE TABLE subscription_history (
    customer_id INT,
    marketplace VARCHAR(10),
    event_date DATE,
    event CHAR(1),
    subscription_period INT
);

