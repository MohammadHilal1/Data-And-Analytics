-- solution --

-- This solution does not guarantee to return first duplicate

SELECT * FROM city_distance cd 
LEFT JOIN city_distance cd_1 
ON cd.source = cd_1.destination AND cd.destination = cd_1.source
WHERE cd_1.source IS NULL OR cd.distance != cd_1.distance OR cd.source < cd_1.destination;

-- This solution guarantee to return firt dupicate

WITH cte AS
(SELECT * , CASE WHEN source < destination THEN source ELSE destination END AS city1,
CASE WHEN source < destination THEN destination ELSE source END AS city2 FROM city_distance),
cte1 AS
(SELECT *, COUNT(*) OVER (PARTITION BY city1, city2, distance) AS cnt FROM cte),
cte2 AS
(SELECT distance, source, destination, ROW_NUMBER() OVER () As rn FROM cte1)

SELECT cd.distance, cd.source, cd.destination FROM cte2 cd 
LEFT JOIN cte2 cd_1 
ON cd.source = cd_1.destination AND cd.destination = cd_1.source
WHERE cd_1.source IS NULL OR cd.distance != cd_1.distance OR cd.rn < cd_1.rn;
