--You are given a table containing daily records of a process status with two columns:
--date_value (of type DATE)
--state (e.g., 'success', 'fail')
--Your goal is to group consecutive dates with the same state into date ranges, and generate an output

--Query to create table and insert data
create table tasks (
date_value date,
state varchar(10)
);

insert into tasks  values ('2019-01-01','success'),('2019-01-02','success'),('2019-01-03','success'),('2019-01-04','fail')
,('2019-01-05','fail'),('2019-01-06','success')

--Solution
WITH all_dates AS
(SELECT *,
ROW_NUMBER() OVER (PARTITION BY state ORDER BY date_value ASC) AS rn,
date_sub(date_value, INTERVAL 1 * ROW_NUMBER() OVER (PARTITION BY state ORDER BY date_value ASC) DAY) AS group_date
FROM tasks
ORDER BY date_value ASC),
group_dates AS
(SELECT group_date, state, min(date_value) AS end_date, max(date_value) AS start_date
FROM all_dates
GROUP BY group_date, state)

SELECT end_date, start_date, state
FROM
group_dates;
