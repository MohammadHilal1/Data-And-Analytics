-- Solution 1 --
WITH all_players AS
(SELECT player, count(match_id) as matches_played FROM 
(SELECT batter as player, match_id FROM cricket_match
UNION
SELECT bowler AS player, match_id FROM cricket_match) AS players_table
GROUP BY player)
SELECT ap.*, COALESCE(batting_matches, 0) AS batting_matches, COALESCE(bowling_matches, 0) AS bowling_matches FROM all_players ap
LEFT JOIN
(SELECT batter, count(distinct match_id) AS batting_matches FROM cricket_match
GROUP BY batter) ab
ON ap.player = ab.batter
LEFT JOIN
(SELECT bowler, count(distinct match_id) AS bowling_matches FROM cricket_match
GROUP BY bowler) abo
ON ap.player = abo.bowler;

-- Solution 2 --
WITH cte AS
(SELECT batter AS player, match_id AS batting_match, null AS bowling_match FROM cricket_match
UNION
SELECT bowler, null AS batting_match, match_id AS bowling_match FROM cricket_match)
SELECT player, 
COUNT(batting_match) AS batting_matches , 
COUNT(bowling_match) AS bowling_matches, 
COUNT(DISTINCT COALESCE(batting_match, bowling_match)) AS matches_played 
FROM cte
GROUP BY player;
