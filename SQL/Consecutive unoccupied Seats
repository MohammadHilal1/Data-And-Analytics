--You are given a movie table containing data about seat occupancy in a movie theater. 
--Each row represents a seat in the format seat (e.g., "A01", "B12") and its occupancy status (0 = vacant, 1 = occupied).
--Your task is to identify all seats that are part of a group of exactly 4 consecutive unoccupied seats in the same row. This is useful for features like:
--finding available seat blocks for families or groups
--optimizing seating arrangements

-- Query to create table and insert data
create table movie(
seat varchar(50),occupancy int
);
insert into movie values('a1',1),('a2',1),('a3',0),('a4',0),('a5',0),('a6',0),('a7',1),('a8',1),('a9',0),('a10',0),
('b1',0),('b2',0),('b3',0),('b4',1),('b5',1),('b6',1),('b7',1),('b8',0),('b9',0),('b10',0),
('c1',0),('c2',1),('c3',0),('c4',1),('c5',1),('c6',0),('c7',1),('c8',0),('c9',0),('c10',1);

-- Solution --
-- Original table: movie (seat, occupancy)

WITH extracted_seat AS (
    SELECT *,
           LEFT(seat, 1) AS seat_row,
           CAST(SUBSTRING(seat, 2, 2) AS UNSIGNED) AS seat_number
    FROM movie
),

vacant_seats_with_row_num AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY seat_row ORDER BY seat_number) AS row_num,
           seat_number - ROW_NUMBER() OVER (PARTITION BY seat_row ORDER BY seat_number) AS group_id
    FROM extracted_seat
    WHERE occupancy = 0
),

grouped_vacant_seats AS (
    SELECT *,
           COUNT(*) OVER (PARTITION BY seat_row, group_id) AS group_size
    FROM vacant_seats_with_row_num
)

-- Final result: seats that belong to a group of exactly 4 consecutive unoccupied seats
SELECT seat, occupancy
FROM grouped_vacant_seats
WHERE group_size = 4;
