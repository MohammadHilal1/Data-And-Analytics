-- Solution

-- 1 Management wants to see all the users that did not login the past 5 months

SELECT Users.USER_ID, Users.USER_NAME FROM logins 
INNER JOIN users ON 
logins.USER_ID = Users.USER_ID 
GROUP BY USER_ID
HAVING MAX(LOGIN_TIMESTAMP) > date_add(curdate(), INTERVAL -5 MONTH);

-- 2 For the business units quarterly analysis calculate how many users and how many sessions were at each quarter 
-- Order by quarter from newest to oldest
-- Return First day of the quarter, user_count and session_count

SELECT YEAR(LOGIN_TIMESTAMP) AS Year, 
QUARTER(LOGIN_TIMESTAMP) AS Quarter,
COUNT(distinct USER_ID) AS users,
COUNT(session_score) AS sessions,
MIN(LOGIN_TIMESTAMP) AS first_quarter_date,
DATE_SUB(last_day(MIN(LOGIN_TIMESTAMP)), INTERVAL DAY(LAST_DAY(MIN(LOGIN_TIMESTAMP))) - 1 day) as first_day_of_month
FROM logins
GROUP BY YEAR(LOGIN_TIMESTAMP), QUARTER(LOGIN_TIMESTAMP)
ORDER BY YEAR(LOGIN_TIMESTAMP) DESC , QUARTER(LOGIN_TIMESTAMP) ASC;

-- 3 Display User ID's that Login january 2025 and did not log in November 2024

SELECT DISTINCT USER_ID FROM Logins
WHERE MONTH(LOGIN_TIMESTAMP) = 1 
AND USER_ID NOT IN (SELECT USER_ID FROM LOGINS WHERE MONTH(LOGIN_TIMESTAMP) = 11);

-- 4 Add to the query from 2 the percentage change in session from last quarter.
-- First day of the quarter, session_count, session_count_prev, session_percentage_change

WITH cte AS
(SELECT YEAR(LOGIN_TIMESTAMP) AS Year, 
QUARTER(LOGIN_TIMESTAMP) AS Quarter,
COUNT(distinct USER_ID) AS users,
COUNT(session_score) AS sessions,
MIN(LOGIN_TIMESTAMP) AS first_quarter_date,
DATE_SUB(last_day(MIN(LOGIN_TIMESTAMP)), INTERVAL DAY(LAST_DAY(MIN(LOGIN_TIMESTAMP))) - 1 day) as first_day_of_month
FROM logins
GROUP BY YEAR(LOGIN_TIMESTAMP), QUARTER(LOGIN_TIMESTAMP)
ORDER BY YEAR(LOGIN_TIMESTAMP) DESC , QUARTER(LOGIN_TIMESTAMP) ASC)
SELECT *, LAG(sessions, 1, 0) OVER (ORDER BY quarter ASC), ROUND((sessions - LAG(sessions, 1, 0) OVER (ORDER BY quarter ASC)) * 100 / LAG(sessions, 1, 0) OVER (ORDER BY quarter ASC), 2) as p
FROM cte;

-- 5 Display the user that had the highest session score for each day

WITH cte AS
(SELECT USER_ID, DATE(LOGIN_TIMESTAMP) AS date, SUM(SESSION_SCORE) AS score
FROM Logins
GROUP BY USER_ID, DATE(LOGIN_TIMESTAMP)),
cte1 AS
(SELECT USER_ID, date, score,
RANK() OVER (PARTITION BY date ORDER BY score DESC) AS rn FROM cte)
SELECT * FROM cte1 WHERE rn = 1;

-- 6 To identify best users Return the users that had a session on every single day since their first login

WITH cte AS
(SELECT USER_ID, 
DATE(LOGIN_TIMESTAMP) AS date, 
DAY(LOGIN_TIMESTAMP) AS day,
ROW_NUMBER() OVER (PARTITION BY USER_ID ORDER BY DATE(LOGIN_TIMESTAMP)) AS rn
FROM logins),
cte1 AS
(SELECT *, CAST(day AS SIGNED) - CAST(rn AS SIGNED) AS diff FROM cte)
SELECT USER_ID FROM cte1
GROUP BY USER_ID
HAVING COUNT(DISTINCT diff) = 1;

-- 7 On what date there were no log in at all

SELECT MIN(DATE(LOGIN_TIMESTAMP)) AS start_date, 
MAX(DATE(LOGIN_TIMESTAMP)) AS end_date
FROM logins;

WITH RECURSIVE cte AS
( 
SELECT MIN(DATE(LOGIN_TIMESTAMP)) AS date, MAX(DATE(LOGIN_TIMESTAMP)) AS end_date FROM logins
UNION ALL
SELECT date_add(date, INTERVAL 1 Day) AS date, end_date FROM cte WHERE date < end_date
)
SELECT date FROM cte LEFT JOIN logins ON cte.date = DATE(LOGIN_TIMESTAMP)
WHERE DATE(LOGIN_TIMESTAMP) IS NULL;
