,('SMS','9168204',1),('OUT','9168204',576),('INC','2159010',5),('INC','2159010',4),('SMS','2159010',1)
,('SMS','4535614',1),('OUT','181868',20),('INC','181868',54),('INC','218748',20),('INC','2159010',9)
,('INC','197432',66),('SMS','2159010',1),('SMS','4535614',1);

-- Solution --
-- Using CTE and Filter
WITH CTE AS
(SELECT call_number, 
SUM(CASE WHEN call_type = "OUT" THEN call_duration ELSE null END) as out_duration, 
SUM(CASE WHEN call_type = "INC" THEN call_duration ELSE null END) as in_duration
FROM call_details
GROUP BY call_number)
SELECT * fROM CTE WHERE out_duration is not null and in_duration is not null and out_duration > in_duration;

-- Using CTE and inner join
WITH cte1 AS
(SELECT call_number, SUM(call_duration) AS duration FROM
call_details
WHERE call_type = "OUT"
GROUP BY call_number),
cte2 AS (SELECT call_number, SUM(call_duration) AS duration FROM
call_details
WHERE call_type = "INC"
GROUP BY call_number)
SELECT cte1.call_number, cte1.duration AS out_duration,
cte2.duration AS in_duration FROM cte1 
INNER JOIN 
cte2 ON 
cte1.call_number = cte2.call_number AND cte1.duration > cte2.duration;
