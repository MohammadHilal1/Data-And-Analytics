--You are given a call_details table that logs phone call records. Each row contains:
--call_number: phone number involved in the call
--call_type: "OUT" for outgoing calls, "INC" for incoming calls
--call_duration: duration of the call in seconds
--Your task is to identify phone numbers that have both incoming and outgoing calls, 
--and where the total duration of outgoing calls is greater than the total duration of incoming calls.

-- SQL query to create table and insert data
create table call_details  (
call_type varchar(10),
call_number varchar(12),
call_duration int
);

