-- Solution -- 

WITH cte AS
(SELECT year(order_date) AS year, SUM(sales) AS sales FROM orders_1
GROUP BY year(order_date))
SELECT *, SUM(sales) OVER (ORDER BY year) AS cummulative_sales FROM cte;

WITH cte AS
(SELECT year(order_date) AS year, category, SUM(sales) AS sales FROM orders_1
GROUP BY year(order_date), category)
SELECT *, SUM(sales) OVER (PARTITION BY category ORDER BY year ASC) AS cummulative_sales FROM cte;

WITH cte AS
(SELECT MONTH(order_date) as month, category, SUM(sales) as sales From orders_1
WHERE order_date >= (SELECT DATE_ADD(MAX(order_date), INTERVAL -4 MONTH) from orders_1)
GROUP BY MONTH(order_date), category)
SELECT *, SUM(sales) OVER (PARTITION BY category ORDER BY month) AS cummulative_sales FROM cte;

WITH cte AS
(SELECT year(order_date) AS year, month(order_date) AS month, SUM(sales) as sales 
FROM orders_1
GROUP BY year(order_date), month(order_date))
SELECT *, SUM(sales) OVER (ROWS BETWEEN 4 PRECEDING AND CURRENT ROW) AS cummulative_sum FROM cte;
