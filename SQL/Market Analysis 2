-- Write an SQL query to find for each seller, whether the brand of the second item(by date) they sold is ther favorite item.
-- If the seller sold less than two items report the answer for that seller as No

-- Query to create the table and insert data
create table users (
user_id         int     ,
 join_date       date    ,
 favorite_brand  varchar(50));

 create table orders (
 order_id       int     ,
 order_date     date    ,
 item_id        int     ,
 buyer_id       int     ,
 seller_id      int 
 );

 create table items
 (
 item_id        int     ,
 item_brand     varchar(50)
 );


 insert into users values (1,'2019-01-01','Lenovo'),(2,'2019-02-09','Samsung'),(3,'2019-01-19','LG'),(4,'2019-05-21','HP');

 insert into items values (1,'Samsung'),(2,'Lenovo'),(3,'LG'),(4,'HP');

 insert into orders values (1,'2019-08-01',4,1,2),(2,'2019-08-02',2,1,3),(3,'2019-08-03',3,2,3),(4,'2019-08-04',1,4,2)
 ,(5,'2019-08-04',1,3,4),(6,'2019-08-05',2,2,4);

--Solution

WITH find_second_items AS (
SELECT seller_id, rn, item_id FROM
(
SELECT *, 
RANK() OVER (PARTITION BY seller_id ORDER BY order_date) AS rn 
FROM orders
) AS f_s
WHERE rn = 2)
SELECT seller_id, 
IF(I.item_brand = U.favorite_brand, "Yes", "No") 
FROM users U 
LEFT JOIN
find_second_items F ON U.user_id = F.seller_id
LEFT JOIN
items I ON F.item_id = I.item_id;
