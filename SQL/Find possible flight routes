-- Find possible flight routes
-- Given airports and flights table
-- You have to find all the possible routes between NEW YORK and Tokyo
-- Make sure if there is connecting flight second flight start time must not be less than end time

-- SQL query to create table and insert data
CREATE TABLE airports (
    port_code VARCHAR(10) PRIMARY KEY,
    city_name VARCHAR(100)
);

CREATE TABLE flights (
    flight_id varchar (10),
    start_port VARCHAR(10),
    end_port VARCHAR(10),
    start_time datetime,
    end_time datetime
);

