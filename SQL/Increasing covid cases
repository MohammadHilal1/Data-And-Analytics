------ Solution 
--1. Using Rank Window Function
WITH cte AS
(SELECT 
* ,
RANK() OVER (PARTITION BY city ORDER BY days ASC) AS rn_days,
RANK() OVER (PARTITION BY city ORDER BY cases ASC) AS rn_cases,
CAST(RANK() OVER (PARTITION BY city ORDER BY days ASC) AS SIGNED) - CAST(RANK() OVER (PARTITION BY city ORDER BY cases ASC)AS SIGNED) AS diff
FROM covid
ORDER BY city, days ASC)
SELECT city FROM cte
GROUP BY city
HAVING COUNT(DISTINCT diff) = 1 and MAX(diff) = 0;

--2. Using LAG Window Function
WITH cte AS 
(
SELECT city, days, cases,
LAG(cases) OVER (PARTITION BY city ORDER BY days) AS prev_cases
FROM covid
)
SELECT * FROM cte;
SELECT city FROM cte
GROUP BY city
HAVING SUM(CASE WHEN prev_cases IS NULL OR cases > prev_cases THEN 0 ELSE 1 END) = 0;
