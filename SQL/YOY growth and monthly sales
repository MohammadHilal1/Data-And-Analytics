-- Solution --
WITH cte AS
(SELECT year(order_date) as year, SUM(sales) as sales FROM orders_1
GROUP BY year(order_date)),
cte1 AS
(SELECT *, LAG(sales, 1, 0) OVER (ORDER BY year) AS prev_year_sales FROM cte)
SELECT *, CONCAT(CAST(IFNULL(round((sales-prev_year_sales)/prev_year_sales,2) * 100, 0) AS char), "%") as yoy_growth FROM cte1;

WITh cte AS
(SELECT year(order_date) as year, month(order_date) as month, product, sum(sales) as sales
FROm orders_1
GROUP BY year(order_date), month(order_date), product),
cte1 AS
(SELECT *, LAG(sales, 1, 0) OVER (PARTITION BY product order by year, month) as prev_month_sales,
ROW_NUMBER() OVER (PARTITION BY product order by year, month) as rn FROM cte),
cte2 AS (SELECT *, MAX(rn) OVER (PArtition BY product) as l_rn FROM cte1)
SELECT * FROM cte2 WHERE rn = l_rn and sales > prev_month_sales;
