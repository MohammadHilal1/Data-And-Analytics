-- Find the start and ending location of each customer

-- SQL to create table and insert data

CREATE TABLE travel_data (
    customer VARCHAR(10),
    start_loc VARCHAR(50),
    end_loc VARCHAR(50)
);

INSERT INTO travel_data (customer, start_loc, end_loc) VALUES
    ('c1', 'New York', 'Lima'),
    ('c1', 'London', 'New York'),
    ('c1', 'Lima', 'Sao Paulo'),
    ('c1', 'Sao Paulo', 'New Delhi'),
    ('c2', 'Mumbai', 'Hyderabad'),
    ('c2', 'Surat', 'Pune'),
    ('c2', 'Hyderabad', 'Surat'),
    ('c3', 'Kochi', 'Kurnool'),
    ('c3', 'Lucknow', 'Agra'),
    ('c3', 'Agra', 'Jaipur'),
    ('c3', 'Jaipur', 'Kochi');

-- Solution --

-- Using in operator and group by
WITH cte AS
(SELECT *, 
CASE WHEN start_loc NOT IN (SELECT end_loc FROM travel_data td1 WHERE td1.customer = td.customer) THEN start_loc END AS initial,
CASE WHEN end_loc NOT IN (SELECT start_loc FROM travel_data td1 WHERE td1.customer = td.customer) THEN end_loc END AS final  
FROM travel_data td)
SELECT customer, MIN(initial) AS start_city, MIN(final) AS end_city FROM cte
GROUP BY customer;

-- using union all

WITH cte AS
(
	SELECT customer, start_loc as loc, "start_loc" as column_type FROM travel_data
    UNION ALL
    SELECT customer, end_loc as loc, "end_loc" as column_type FROM travel_data
),
cte1 AS
(SELECT *, count(*) OVER (PARTITION BY customer, loc) as count FROM cte 
ORDER BY customer)
SELECT customer, MAX(CASE WHEN column_type = "start_loc" THEN loc END) AS start_loc,
MAX(CASE WHEN column_type = "end_loc" THEN loc END) AS end_loc FROM cte1 where count = 1
GROUP BY customer;

-- Using self join

WITH cte1 AS
(SELECT t1.*, CASE WHEN t2.end_loc IS NULL THEN t1.start_loc END AS starting_location FROM travel_data t1 LEFT JOIN travel_data t2
ON t1.customer = t2.customer AND t1.start_loc = t2.end_loc),
cte2 AS
(SELECT t1.*, CASE WHEN t2.start_loc IS NULL THEN t1.end_loc END AS ending_location FROM travel_data t1 LEFT JOIN travel_data t2 
ON t1.customer = t2.customer AND t1.end_loc = t2.start_loc)
SELECT cte1.customer, 
MAX(starting_location) AS starting_loc, 
MAX(ending_location) AS ending_loc FROM cte1 INNER JOIN cte2 
ON cte1.customer = cte2.customer and cte1.start_loc = cte2.start_loc
GROUP By cte1.customer;
