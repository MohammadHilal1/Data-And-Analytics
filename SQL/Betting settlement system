-- Solution --

WITH cte1 AS
(SELECT polls.poll_id, polls.user_id, 
polls.amount FROM polls 
INNER JOIN poll_answers 
ON polls.poll_id = poll_answers.poll_id 
AND polls.poll_option_id = poll_answers.correct_option_id),
cte2 AS
(SELECT polls.poll_id, SUM(amount) AS amount_to_be_distributed FROM polls 
INNER JOIN poll_answers 
ON polls.poll_id = poll_answers.poll_id 
AND polls.poll_option_id != poll_answers.correct_option_id
GROUP BY polls.poll_id)

SELECT cte1.poll_id, 
cte1.user_id,
amount_to_be_distributed/SUM(amount) OVER (PARTITION BY cte1.poll_id) * amount AS amount_dist 
FROM cte1 INNER JOIN cte2 ON cte1.poll_id = cte2.poll_id;
