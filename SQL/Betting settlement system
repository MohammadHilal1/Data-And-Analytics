-- Task -> Write a SQL query that implements settlement process, distributing the losing pool proportionately among the users who selected the correct option.

-- Settlement Rules
-- All the money invested in the losing options (A, B, D) should be proportionately distributed among the users who invested in the winning option (C).
-- The proportion of payout to each winning user is based on their contribution percentage in the total amount invested in the winning option.
-- Example:
-- Total losing pool = 1500
-- 3 users bet on winning option C with contributions of 500, 200, and 50.
-- Their proportion is: 500:200:50 → (5:2:0.5).
-- Final settlement distributed = 750, 600, 150 (summing to 1500).

-- SQL query to create table and insert data

create table polls
(
user_id varchar(4),
poll_id varchar(3),
poll_option_id varchar(3),
amount int,
created_date date
);
