--Problem
-- Given a table of users activity need to find the second most recent activity of each user and if the user has only one activity it should return that activity

-- SQL query to create table and insert data

create table UserActivity
(
username      varchar(20) ,
activity      varchar(20),
startDate     Date   ,
endDate      Date
);

insert into UserActivity values 
('Alice','Travel','2020-02-12','2020-02-20')
,('Alice','Dancing','2020-02-21','2020-02-23')
,('Alice','Travel','2020-02-24','2020-02-28')
,('Bob','Travel','2020-02-11','2020-02-18');

-- Solution
WITH cte AS
(SELECT *, 
COUNT(1) OVER (PARTITION BY username) AS total_activities,
ROW_NUMBER() OVER (PARTITION BY username ORDER BY startDate DESC) AS rn FROM userActivity)

SELECT *
FROM cte
WHERE total_activities = 1 OR rn=2;
