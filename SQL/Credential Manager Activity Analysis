-- Problem
-- Credential Managers Activity Analysis
-- A credential management platform maintains a list of 'ERROR' and 'SUCCESS' result types and their timestamps for user accounts. As part of the maintenance process, a report must be generated that lists all sequences of three or more consecutive 'ERROR' results for each account.
-- Create a query that returns a list of all accounts and their associated error sequences.
-- The result should have the following columns:
-- mac | type | started_at | ended_at | activities
-- mac – account MAC address
-- type – activity result
-- started_at – date and time the sequence started
-- ended_at – date and time the sequence ended
-- activities – number of activities in a sequence
-- The report should be sorted in ascending order by mac, then in ascending order by started_at.
- Note:
-- Only sequences of 3 or more consecutive 'ERROR' results for an account should be included in the result.

-- SQL query to create table and insert data
CREATE TABLE activities (
    id INT AUTO_INCREMENT PRIMARY KEY,
    mac VARCHAR(20),
    type VARCHAR(10),         -- 'ERROR' or 'SUCCESS'
    timestamp DATETIME
);

DELIMITER //

CREATE PROCEDURE insert_sample_data()
BEGIN
    DECLARE i INT DEFAULT 0;
    DECLARE rand_mac INT;
    DECLARE rand_type VARCHAR(10);
    DECLARE rand_minutes INT;

    WHILE i < 120 DO
        SET rand_mac = FLOOR(1 + RAND() * 5); -- MAC_1 to MAC_5
        SET rand_type = IF(RAND() < 0.4, 'ERROR', 'SUCCESS'); -- 40% chance of ERROR
        SET rand_minutes = FLOOR(RAND() * 5000); -- random minutes ago

        INSERT INTO activities (mac, type, timestamp)
        VALUES (
            CONCAT('MAC_', rand_mac),
            rand_type,
            NOW() - INTERVAL rand_minutes MINUTE
        );

        SET i = i + 1;
    END WHILE;
END //

DELIMITER ;

CALL insert_sample_data();

------ Solution
WITH cte1 AS (SELECT *, 
ROW_NUMBER() OVER (PARTITION BY mac ORDER BY timestamp) AS rn 
FROM activities),
cte2 AS (SELECT *, 
CASE WHEN type = "ERROR" THEN 1 ELSE 0 END AS is_error 
FROM cte1),
grouped AS (SELECT *, rn - SUM(is_error) OVER (PARTITION BY mac ORDER BY rn ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS grp FROM cte2),
error_sequence AS (SELECT mac, 
MIN(timestamp) AS started_at, 
MAX(timestamp) AS ended_at,
COUNT(*) AS activities
FROM grouped
WHERE type="ERROR"
GROUP BY mac, grp
HAVING count(*) > 2)
SELECT mac, "Error" AS type, started_at, ended_at, activities
FROM error_sequence
ORDER BY mac, started_at;

