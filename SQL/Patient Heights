--Problem
-- Given a patient table find height of all patients who are taller than the average height of pateients of there own gender

-- SQL query to create table and insert data

CREATE TABLE patients (
    patient_id INT PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    gender CHAR(1),
    birth_date DATE,
    city VARCHAR(50),
    height INT,
    weight INT
);

