-- Solution --
WITH cte AS
(SELECT date(transaction_date) AS transaction_date , 
SUM(CASE WHEN type = "withdrawal" THEN amount * -1 ELSE amount END)  AS amount
FROM transactions
GROUP BY date(transaction_date)
ORDER BY date(transaction_date))
SELECT *,
SUM(amount) OVER (Partition BY Year(transaction_date), Month(transaction_date) ORDER BY transaction_date) AS cum_sum
FROM cte;
