-- Write a query to print the cummulative balance of merchant at the end of each day
-- with the total balance reset back to zero at the end of the month
-- Output the transaction date and cummulative balance

-- SQL query to create table and insert data

CREATE TABLE transactions (
    transaction_id INT PRIMARY KEY,
    type VARCHAR(20),
    amount DECIMAL(10,2),
    transaction_date DATETIME
);

