-- Problem
-- Given transactions find out the customers retained and customers churned in each month


-- SQL query to create table and insert data

create table transactions(
order_id int,
cust_id int,
order_date date,
amount int
);
insert into transactions values 
(1,1,'2020-01-15',150)
,(2,1,'2020-02-10',150)
,(3,2,'2020-01-16',150)
,(4,2,'2020-02-25',150)
,(5,3,'2020-01-10',150)
,(6,3,'2020-02-20',150)
,(7,4,'2020-01-20',150)
,(8,5,'2020-02-20',150)
;

--Solution
1-- Query to find retained customers
WITH monthly_orders AS
(SELECT cust_id, DATE_FORMAT(order_date, "%Y-%m") AS order_month, 
lag(DATE_FORMAT(order_date, "%Y-%m")) OVER (PARTITION BY cust_id ORDER BY DATE_FORMAT(order_date, "%Y-%m") ASC) AS prev_order_month 
FROM transactions)
SELECT order_month, 
COUNT(DISTINCT cust_id) AS customers,
COUNT(DISTINCT CASE WHEN prev_order_month IS NOT NULL THEN cust_id END) AS repeated_customers
FROM monthly_orders
GROUP BY order_month;

2-- Query to find churned customers
WITH monthly_orders AS (
SELECT cust_id, DATE_FORMAT(order_date, "%Y-%m") AS order_month,
LEAD(DATE_FORMAT(order_date, "%Y-%m")) OVER (PARTITION BY cust_id ORDER By DATE_FORMAT(order_date, "%Y-%m") ASC) AS next_order_month
FROM transactions)
SELECT 
  order_month,
  COUNT(DISTINCT cust_id) AS active_customers,
  COUNT(DISTINCT CASE WHEN next_order_month IS NULL THEN cust_id END) AS churned_customers
FROM monthly_orders
GROUP BY order_month;
