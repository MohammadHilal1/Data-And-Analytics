-- analyze player interactions within games recorded in the user_interactions table.
-- Each record in this table contains information about a specific game_id, the user_id, and the type of interaction (interaction_type).
-- The goal is to classify each game based on the nature of interactions among the players:
-- No interaction – if there are no interaction records for the game.
-- One-sided interaction – if interactions exist but all messages come from only one player.
-- Both-sided interaction without custom typed messages – if interactions exist from more than one player but none of them sent a "custom_typed" message.
-- Both-sided interaction with custom typed messages – if interactions exist from more than one player and at least one of them sent a "custom_typed" message.
-- After classifying each game, we need to calculate the percentage distribution of games across these categories to understand how players interact in different games.

-- Sql query to create table and insert data

CREATE TABLE user_interactions (
    user_id varchar(10),
    event varchar(15),
    event_date DATE,
    interaction_type varchar(15),
    game_id varchar(10),
    event_time TIME
);

