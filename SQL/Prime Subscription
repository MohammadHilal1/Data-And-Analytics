-- Solutions to the problem
-- 1
SELECT 
ROUND(COUNT(DISTINCT CASE WHEN DATEDIFF(e1.access_date, u.join_date) <= 30 THEN e.user_id END )/COUNT(Distinct u.user_id), 2)*100  AS Prime_Subscription_Rate
FROM users u
INNER JOIN EVENTS e
ON u.user_id = e.user_id AND e.TYPE = "Music"
LEFT JOIN EVENTS e1
ON u.user_id = e1.user_id AND e1.TYPE = "P";

-- 2
SELECT
ROUND(COUNT(DISTINCT CASE WHEN DATEDIFF(e.access_date, u.join_date) <= 30 THEN u.user_id ELSE null END)/ COUNT(DISTINCT u.user_id)*100,2) AS Prime_Subscription_Rate 
FROM users u
LEFT JOIN EVENTS e
ON e.user_id = u.user_id AND e.TYPE = "P"
WHERE u.user_id IN (SELECT user_id FROM EVENTS WHERE TYPE="Music");
