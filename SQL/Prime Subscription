-- Problem
-- Prime Subscription rate by product action
-- Given the two tables return the fraction of users rounded to 2 decimal places who accessed amazon music
-- and upgrade to prime mebership within the first 30 days of signing up

-- SQL query to create table and insert values

create table users
(
user_id integer,
name varchar(20),
join_date date
);
