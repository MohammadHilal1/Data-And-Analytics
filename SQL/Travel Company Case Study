-- Write an sql query that gives the segment summary of how many users in each segment and how many of them booked ticket in APR 2022

WITH cte AS
(SELECT 
bt.*, ut.segment, ut.User_id AS usr_id FROM user_table ut
LEFT JOIN
booking_table bt ON
ut.User_id = bt.User_id),
cte1 AS
(SELECT segment, count(DISTINCT usr_id) AS total_users FROM cte GROUP BY segment),
cte2 AS
(SELECT segment AS sgmnt, 
count(DISTINCT user_id) AS users_booked_ticket_in_apr_2022
FROM cte
WHERE MoNTH(booking_date) = 4 AND YEAR(booking_date) = 2022
GROUP BY segment)
SELECT segment, 
total_users, 
users_booked_ticket_in_apr_2022 FROM cte1 INNER JOIN cte2 ON cte1.segment = cte2.sgmnt;

-- Write a SQL query to identify users whose first booking was a hotel booking

WITH cte AS
(SELECT *, ROW_NUMBER() OVER (PARTITION BY User_id ORDER BY Booking_date) AS rn FROM booking_table)
SELECT * FROM cte WHERE rn=1 and Line_of_business = "Hotel";

-- Write a SQL query to calculate the days between first and last booking of each user

WITH cte AS
(SELECT User_id, 
MIN(Booking_date) AS first_booking,
MAX(Booking_date) AS last_booking  
FROM booking_table
GROUP By User_id)
SELECT User_id, datediff(last_booking, first_booking) as diff FROM cte;

-- Write a SQL query to count the number of flight and hotel bookings in each of the user segments for the year 2022

with cte AS
(SELECT segment, 
count(CASE WHEN Line_of_business = "Flight" THEN 1 END) AS number_of_flights,
count(CASE WHEN Line_of_business = "Hotel"  THEN 1 END) AS number_of_hotels
FROM Booking_table 
INNER JOIN user_table
ON Booking_table.User_id = user_table.User_id
WHERE Year(Booking_date) = 2022
GROUP BY segment)
SELECT * FROM cte;
