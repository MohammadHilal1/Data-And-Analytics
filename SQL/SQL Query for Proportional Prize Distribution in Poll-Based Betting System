('p1', 'C'),('p2', 'A');

-- Solution -- 

WITH cte AS
(SELECT polls.*, poll_answers.correct_option_id, 
CASE WHEN poll_option_id = correct_option_id THEN 1 ELSE 0 END AS correct_flag FROM polls 
INNER JOIN poll_answers
ON polls.poll_id = poll_answers.poll_id),
investment_and_won_amount AS
(SELECT *, 
SUM(CASE WHEN correct_flag = 1 THEN amount ELSE 0 END) OVER (PARTITION BY poll_id) AS investment,
SUM(CASE WHEN correct_flag = 0 THEN amount ELSE 0 END) OVER (PARTITION BY poll_id) AS won_amount
FROM cte)
SELECT user_id, poll_id, amount, amount*won_amount/investment as won_amount FROM investment_and_won_amount
WHERE correct_flag = 1;
