-- Find the departments with the average salary less than the companys average salary but there is a constraint 
-- When comparing the departments average salary with the company average salary, the departments must not be included in the companys average salary

-- SQL query tto create table and insertd data

create table emp(
emp_id int,
emp_name varchar(20),
department_id int,
salary int,
manager_id int,
emp_age int);

