-- Solution --

WITH cte AS
(SELECT department_id, 
AVG(salary) AS dept_avg,
COUNT(*) AS total_emp,
SUM(salary) AS salary_total
FROM emp
GROUP BY department_id),
cte1 AS
(SELECT c1.department_id, c1.dept_avg, c2.department_id as dept_id, c2.total_emp, c2.salary_total FROM cte c1 
INNER JOIN cte c2 ON c1.department_id != c2.department_id)
SELECT department_id, dept_avg, SUM(salary_total)/SUM(total_emp) AS company_avg_sal
FROM cte1
GROUP BY department_id, dept_avg
HAVING dept_avg < SUM(salary_total)/SUM(total_emp);
