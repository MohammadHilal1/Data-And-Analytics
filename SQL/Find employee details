-- Given two tables employee_checkin_deatils and employee_details. Write a query to find the employee total actions,
-- total logins, total logouts, latest logout, latest login and default phone number

-- SQL query to create table and insert data

CREATE TABLE employee_checkin_details (
    employeeid INT,
    entry_details VARCHAR(10),
    timestamp_details DATETIME(3)  -- (3) for milliseconds precision
);

INSERT INTO employee_checkin_details (employeeid, entry_details, timestamp_details) VALUES
(1000, 'login',  '2023-06-16 01:00:15.34'),
(1000, 'login',  '2023-06-16 02:00:15.34'),
(1000, 'login',  '2023-06-16 03:00:15.34'),
(1000, 'logout', '2023-06-16 12:00:15.34'),
(1001, 'login',  '2023-06-16 01:00:15.34'),
(1001, 'login',  '2023-06-16 02:00:15.34'),
(1001, 'login',  '2023-06-16 03:00:15.34'),
(1001, 'logout', '2023-06-16 12:00:15.34');

CREATE TABLE employee_details (
    employeeid INT,
    phone_number VARCHAR(20),
    isdefault BOOLEAN
);

INSERT INTO employee_details (employeeid, phone_number, isdefault) VALUES
(1001, '9999',  FALSE),
(1001, '1111',  FALSE),
(1001, '2222',  TRUE),
(1003, '3333',  FALSE);

-- Solution --

with cte AS
(SELECT employeeid, 
count(1) as totalentry, 
count(CASE wHEN entry_details = "login" THEN 1 END) as total_login,
count(CASE WHEN entry_details = "logout" THEN 1 END)  as total_logout,
MAX( CASE WHEN entry_details = "login" THEN timestamp_details ELSE NULL END) latest_login,
MAX( CASE WHEN entry_details = "logout" THEN timestamp_details ELSE NULL END) latest_logout
FROM employee_checkin_details
GROUP BY employeeid)
SELECT cte.*, CASE WHEN employee_details.isdefault = True THEN employee_details.phone_number ELSE "No default number" END AS default_number
FROM cte 
LEFT JOIN 
employee_details ON cte.employeeid = employee_details.employeeid and employee_details.isdefault = True;
