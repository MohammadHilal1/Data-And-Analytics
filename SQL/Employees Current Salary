-- In your organization, each employee has a fixed joining salary recorded at the time they start. 
-- Over time, employees may receive one or more promotions, each offering a certain percentage increase to their current salary.
-- You're given two datasets:
-- employees :  contains each employee’s name and joining salary.
-- promotions:  lists all promotions that have occurred, including the promotion date and the percent increase granted during that promotion.
-- Your task is to write a SQL query to compute the current salary of every employee 
-- by applying each of their promotions increase round to 1 decimal places.
-- If an employee has no promotions, their current salary remains equal to the joining salary. Order the result by emp id.

-- SQL query to create table and insert data

-- Create employees table
CREATE TABLE employees (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    joining_salary INT
);

-- Insert values
INSERT INTO employees (id, name, joining_salary) VALUES
(1, 'Alice', 50000),
(2, 'Bob', 60000),
(3, 'Charlie', 70000),
(4, 'David', 55000),
(5, 'Eva', 65000),
(6, 'Frank', 48000),
(7, 'Grace', 72000),
(8, 'Henry', 51000);

-- Create promotions table
CREATE TABLE promotions (
    emp_id INT,
    promotion_date DATE,
    percent_increase INT,
    FOREIGN KEY (emp_id) REFERENCES employees(id)
);

-- Insert values
INSERT INTO promotions (emp_id, promotion_date, percent_increase) VALUES
(1, '2021-01-15', 10),
(1, '2022-03-20', 20),
(2, '2023-01-01', 5),
(2, '2024-01-01', 10),
(3, '2022-05-10', 5),
(3, '2023-07-01', 10),
(3, '2024-10-10', 5),
(4, '2021-09-21', 15),
(4, '2021-09-25', 15),
(4, '2023-09-01', 15),
(4, '2024-09-30', 15);

WITH RECURSIVE cte AS (
SELECT id, name, joining_salary, CAST(joining_salary AS decimal(8,1)) AS current_sal, 0 AS promo_id FROM employees
UNION ALL
SELECT id, name, joining_salary,
cte.current_sal * (100.0 + promos.percent_increase) / 100.0 AS current_sal,
cte.promo_id + 1 
FROM cte INNER JOIN
(SELECT *,
ROW_NUMBER() OVER (PARTITION BY emp_id ORDER BY promotion_date) AS promo_id FROM promotions) AS promos
ON promos.emp_id = cte.id AND promos.promo_id = cte.promo_id+1)
SELECT id, name, 
joining_salary As initial_salary, 
TRIM(TRAILING '.0' FROM MAX(current_sal)+0) AS current_salary
FROM cte
GROUP BY id, name, joining_salary
ORDER BY id, name;
