       (2, 5, '2019-07-05 09:00:00.000'),
       (2, 3, '2019-07-05 17:00:00.000'),
       (2, 3, '2019-07-05 17:20:00.000'),
       (2, 5, '2019-07-05 23:00:00.000'),
       (2, 3, '2019-08-01 09:00:00.000'),
       (2, 3, '2019-08-01 17:00:00.000'),
       (2, 5, '2019-08-01 19:30:00.000'),
       (2, 4, '2019-08-02 09:00:00.000'),
       (2, 5, '2019-08-02 10:00:00.000'),
       (2, 5, '2019-08-02 10:45:00.000'),
       (2, 4, '2019-08-02 11:00:00.000');

-- Solution --
WITH cte AS
(SELECT *, ROW_NUMBER() OVER (PARTITION BY Callerid, DATE(Datecalled)) AS dt_rn FROM phonelog),
cte1 AS
(SELECT *, 
min(dt_rn) OVER (partition by CallerId, DATE(Datecalled)) AS min,
max(dt_rn) OVER (partition by CallerId, DATE(Datecalled)) AS max
FROM cte),
cte2 AS
(SELECT * FROM cte1
WHERE dt_rn = min OR dt_rn = max)
SELECT Callerid, DATE(Datecalled) AS date FROM cte2 
GROUP BY Callerid, DATE(Datecalled)
HAVING count(Distinct Recipientid) = 1;
