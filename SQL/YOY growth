------Solution

WITH cte AS
(SELECT store_id, 
year, 
SUM(sales) AS yearly_sales FROM yoy_growth_data
GROUP BY store_id, year)

SELECT store_id,
year,
yearly_sales,
round(yearly_sales/LAG(yearly_sales) OVER (PARTITION BY store_id ORDER BY year)*100) as yoy_growth
FROM cte;
