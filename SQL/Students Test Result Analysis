-- Write an sql query to get the list of students who scored above the average marks in each subject

WITH avg_cte AS
(SELECT subject, AVG(marks) AS average FROM students
GROUP BY subject)
SELECT 
*
FROM 
students s 
INNER JOIN
avg_cte ac
ON s.subject = ac.subject
WHERE s.marks > ac.average;

-- Write an SQL query to get the percentage of students who scored more than 90 in any subject among the total students

SELECT 
round(count(DISTINCT studentid)/(SELECT count(DISTINCT studentid) FROM students) * 100, 2) AS percent_of_students_scored_above_90 
FROM students WHERE marks > 90;

-- Write an sql query to get the second highest and second lowest score for each subject

WITH cte AS
(SELECT *, 
RANK() OVER (PARTITION BY subject ORDER BY marks ASC) AS rn_1,
RANK() OVER (PARTITION BY subject ORDER BY marks DESC) AS rn_2
FROM students)
SELECT subject, 
MAX(marks) AS second_highest_marks,
MIN(marks) AS second_lowest_marks
FROM
cte 
WHERE rn_1 = 2 OR rn_2 = 2
GRoUP BY subject;

-- For each student and test, identify if there marks increased or decreased form the previous test

WITH cte AS
(SELECT *,  
LAG(marks) OVER (PARTITION BY studentid ORDER BY testdate) AS prev_test_marks 
FROM students)
SELECT studentid, testid, marks,
CASE WHEN marks > prev_test_marks THEN "Inreased" WHEN marks < prev_test_marks THEN "Decreased" ELSE "First Test" END AS status
FROM cte
ORDER BY studentid;
