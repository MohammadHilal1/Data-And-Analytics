#Find products that are within the budget of customer

#SQLquery to create table and insert data

create table products
(
product_id varchar(20) ,
cost int
);
insert into products values ('P1',200),('P2',300),('P3',500),('P4',800);

create table customer_budget
(
customer_id int,
budget int
);

------ Solution

insert into customer_budget values (100,400),(200,800),(300,1500);

with cte AS
(SELECT *, SUM(cost) OVER (ORDER BY cost asc) as cost_sum
FROM products)
SELECT customer_id, MAx(budget), count(product_id), group_concat(product_id order by c.cost asc)
FROM customer_budget cb 
LEFT JOIN cte c ON c.cost_sum < cb.budget
group by customer_id;
