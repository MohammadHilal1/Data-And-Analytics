-- Solution -- 
create view view_1 AS
(SELECT *, ROW_NUMBER() OVER (ORDER BY hall_id, start_date) AS event_id FROM hall_events);

WITH RECURSIVE r_cte AS
(SELECT hall_id, start_date, end_date, event_id, 1 as flag FROM view_1 WHERE event_id = 1
UNION ALL 
SELECT view_1.hall_id, view_1.start_date, view_1.end_date, view_1.event_id,
CASE WHEN view_1.hall_id = r_cte.hall_id AND 
(view_1.start_date BETWEEN r_cte.start_date AND r_cte.end_date
OR r_cte.start_date BETWEEN view_1.start_date AND view_1.end_date) THEN 0 ELSE 1 END + flag AS flag
FROM r_cte INNER JOIN view_1 
ON r_cte.event_id+1 = view_1.event_id)
SELECT hall_id, flag, MIN(start_date) AS start_Date, MAX(end_date) AS end_date FROM r_cte
GROUP By hall_id, flag;
