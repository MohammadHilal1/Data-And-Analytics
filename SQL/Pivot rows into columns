-- The company records all sales transactions in an orders table (orders_1) with details such as order date, sales amount, and product category.
-- Management wants to analyze yearly sales distribution across categories to identify which product segments are contributing most to the business over time.
-- The specific goals are:
-- Aggregate yearly sales by category – Calculate the total sales for each product category (Electronics, Furniture, Fashion, Books) grouped by year.
-- Pivot category sales into columns – Present the sales of each category side by side for every year to enable easy comparison across categories.
-- Support trend analysis – Enable management to track how sales in each category are increasing, declining, or remaining stable across years.

-- SQL query to create table and insert data

CREATE TABLE orders_1 (
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    product VARCHAR(100) NOT NULL,
    category VARCHAR(50) NOT NULL,
    sales DECIMAL(10,2) NOT NULL,
    order_date DATE NOT NULL
);

