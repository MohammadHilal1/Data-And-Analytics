-- Solution --

WITH cte AS
(SELECT * , ROW_NUMBER() OVER (PARTITION BY tran_date) AS rn FROM transactions)
SELECT q1.customer_id AS buyer, q2.customer_id AS seller, COUNT(*) AS no_of_transactions FROM
(SELECT * FROM cte WHERE rn = 1) q1
JOIN (SELECT * FROM cte WHERE rn = 2) q2
ON q1.tran_date = q2.tran_date 
AND q1.customer_id NOT IN (SELECT customer_id FROM cte WHERE rn = 2) 
AND q2.customer_id NOT IN (SELECT customer_id FROM cte WHERE rn = 1)
GROUP BY q1.customer_id, q2.customer_id;
