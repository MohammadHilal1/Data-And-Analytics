-- Given a transaction table Which contains transactions between seller and buyer. The structure of table is 
-- Transaction_id, customer_id, amount, trans_date
-- Every successful transaction will have 2 row entries in the table with two different transaction ids, the first one for the seller
-- where their customer_id will be registered and the second one for the buyer where there customer_id will be registered. The amount adn date time
-- for both will however be the same.
-- Write an SQL query to find the top 5 seller buyer combinations who have had maximum transaction between them
-- Disqualify the sellers who have acted as buyers and also the buyers who have acted as sellers 

-- SQL query to create table and insert data

CREATE TABLE transactions (
    transaction_id INT PRIMARY KEY,
    customer_id INT,
    amount INT,
    tran_Date datetime
);
