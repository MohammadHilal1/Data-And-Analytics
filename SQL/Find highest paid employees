-- Find top 2 highest salaried employees
SELECT * FROM employees
ORDER BY salary desc
LIMIT 2;

-- Find top 2 highest salaried employees in each department
WITH cte AS
(SELECT *, RANK() OVER (PARTITION BY department ORDER BY salary DESC) as rn FROM employees)
SELECT * FROM cte WHERE rn <= 2;
