-- Solution

-- Method 1
WITH cte AS
(SELECT *, 
ROW_NUMBER() OVER (ORDER BY seat_id) AS filter_rn,
seat_id - ROW_NUMBER() OVER (ORDER BY seat_id) AS dif
FROM cinema WHERE free=1),
cte1 AS
(SELECT *, count(*) OVER (PARTITION BY dif) AS count FROM cte)
SELECT seat_id FROM cte1 WHERE count >= 2;

-- Method 2
SELECT * FROM cinema c1
JOIN cinema c2 ON c1.seat_id + 1 = c2.seat_id WHERE c2.free = 1;
