-- Find each department highest salried Employee details

-- SQLquery to create table and insert data
-- Create Department table
CREATE TABLE Department (
    id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL
);

-- Create Employee table
CREATE TABLE Employee (
    id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    salary INT NOT NULL,
    departmentId INT,
    FOREIGN KEY (departmentId) REFERENCES Department(id)
);

-- Insert values into Department
INSERT INTO Department (id, name) VALUES
(1, 'IT'),
(2, 'Sales');

-- Insert values into Employee
INSERT INTO Employee (id, name, salary, departmentId) VALUES
(1, 'Joe', 70000, 1),
(2, 'Jim', 90000, 1),
(3, 'Henry', 80000, 2),
(4, 'Sam', 60000, 2),
(5, 'Max', 90000, 1);

-- Solution

WITH cte AS
(SELECT E.*,
D.name AS Department, 
DENSE_RANK() OVER (Partition BY D.id ORDER BY salary DESC) AS rn 
FROM Employee E
INNER JOIN
Department D
ON E.departmentId = D.id)
SELECT Department, name AS Employee, Salary FROM cte WHERE rn=1;
